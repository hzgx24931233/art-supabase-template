# 【通用】环境变量
#
# 当前项目：xmgl（Supabase ref: trthbpyqubyjtkzmcewy）
#
# 本文件是平台的运行契约（模块构建时也会读取）。派生新项目时，把下面标注为
# 「本项目值」的配置换成自己的 Supabase 项目与密钥，不要把 service_role key 提交进仓库。

#  版本号
VITE_VERSION = 3.0.2

# 独立应用标识：platform（平台宿主） / fms（财务管理模块）
VITE_APP_CODE = platform

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# API provider: supabase / java
VITE_API_PROVIDER = supabase

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥（换成自己的随机串）
VITE_LOCK_ENCRYPT_KEY = change-me-lock-encrypt-key

# 打包输出目录
VITE_OUT_DIR = dist

# Supabase 项目地址与 publishable（客户端）密钥 —— 本项目值
# publishable key 会随前端产物下发，这是设计如此；不要在此使用 service_role / secret key。
VITE_SUPABASE_URL=https://trthbpyqubyjtkzmcewy.supabase.co
VITE_SUPABASE_KEY=sb_publishable_upW6Y9gLAkSTrFtGb0BPlw_cy8a1pG2

# 高德地图 JS API Key 与安全密钥（用到地址选择/地理围栏时填写）
VITE_AMAP_KEY=your-amap-js-api-key
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code
