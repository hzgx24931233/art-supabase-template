# 【通用】环境变量
#
# 本文件是平台的运行契约（模块构建时也会读取），请直接把此处占位值替换为
# 派生项目自己的真实配置，不要把真实密钥提交到公开仓库。

#  版本号
VITE_VERSION = 3.0.2

# 独立应用标识：platform（平台宿主） / fms（财务管理模块）
VITE_APP_CODE = platform

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# API provider: supabase / java
VITE_API_PROVIDER = supabase

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥（请替换为自己的随机字符串）
VITE_LOCK_ENCRYPT_KEY = change-me-lock-encrypt-key

# 打包输出目录
VITE_OUT_DIR = dist

# Supabase 项目地址与匿名（publishable）密钥
# 控制台 → Project Settings → API 获取
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-supabase-publishable-key

# 高德地图 JS API Key 与安全密钥（用到地址选择/地理围栏时填写）
VITE_AMAP_KEY=your-amap-js-api-key
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code
