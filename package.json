{
  "name": "art-supabase-pro",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "types": "./src/types/platform-runtime.d.ts",
  "files": [
    ".auto-import.json",
    ".env",
    ".env.development",
    ".env.production",
    "src",
    "public",
    "scripts/ui-audit.ts",
    "scripts/build-log-policy.mjs",
    "scripts/build-log-policy.d.mts"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "build:all": "pnpm modules:build && pnpm build",
    "modules": "tsx scripts/manage-modules.ts",
    "modules:status": "tsx scripts/manage-modules.ts status",
    "modules:pull": "tsx scripts/manage-modules.ts pull",
    "modules:update": "tsx scripts/manage-modules.ts update",
    "modules:install": "tsx scripts/manage-modules.ts install",
    "modules:check": "tsx scripts/manage-modules.ts check",
    "modules:build": "tsx scripts/manage-modules.ts build",
    "modules:setup": "tsx scripts/manage-modules.ts setup",
    "repo:pull": "tsx scripts/repository-workflow.ts pull",
    "repo:publish": "tsx scripts/repository-workflow.ts publish",
    "build:analyze": "tsx scripts/analyze-build.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "database:security:audit": "tsx scripts/audit-database-security.ts",
    "baseline:platform": "tsx scripts/build-platform-baseline.ts",
    "permissions:audit": "tsx scripts/audit-business-permissions.ts",
    "reuse:audit": "tsx scripts/audit-shared-reuse.ts",
    "snapshot:ai": "tsx scripts/generate-ai-project-snapshot.ts",
    "snapshot:check": "tsx scripts/generate-ai-project-snapshot.ts --check",
    "ui:audit": "tsx scripts/ui-audit.ts",
    "serve": "tsx scripts/serve-built-app.ts",
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,tsx,vue}\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"*.{js,mjs,cjs,ts}\"",
    "typecheck": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js --noEmit --pretty false",
    "test:unit": "tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('.artifacts/coverage',{recursive:true})\" && tsx --test --test-concurrency=1 --experimental-test-coverage --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=.artifacts/coverage/lcov.info \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-include=supabase/functions/_shared/*.ts\" \"--test-coverage-include=scripts/*.ts\" --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=80 tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth-pages.accessibility.spec.ts --project=public-desktop-1440 --project=public-mobile-390",
    "test:e2e:critical": "playwright test tests/e2e/ai-configuration-inheritance.smoke.spec.ts --project=desktop-1440",
    "test:e2e:core": "playwright test tests/e2e/core-pages.visual.spec.ts --project=desktop-1440 --project=mobile-390",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "check:fast": "pnpm ui:audit && pnpm reuse:audit && pnpm permissions:audit && pnpm database:security:audit && pnpm typecheck && pnpm lint && pnpm test:unit",
    "check": "pnpm check:fast && pnpm lint:stylelint",
    "check:ci": "pnpm ui:audit && pnpm reuse:audit && pnpm permissions:audit && pnpm typecheck && pnpm lint && pnpm lint:stylelint && pnpm test:coverage && pnpm snapshot:check && pnpm build && pnpm bundle:check && pnpm test:e2e:auth && pnpm test:e2e:critical && pnpm test:e2e:core",
    "fix": "pnpm lint --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "git-hooks:install": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,jsonc}": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{html,htm}": [
      "prettier --write"
    ],
    "*.{scss,css,less}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ],
    "*.{yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@file-viewer/preset-all": "3.1.2",
    "@file-viewer/vue3": "3.1.2",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@iconify/vue": "^5.0.3",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-character-count": "3.31.0",
    "@tiptap/extension-file-handler": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/extension-task-item": "3.31.0",
    "@tiptap/extension-task-list": "3.31.0",
    "@tiptap/extension-text-align": "3.31.0",
    "@tiptap/extension-text-style": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@tiptap/vue-3": "3.31.0",
    "@tresjs/core": "5.8.3",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "docx-preview": "^0.4.1",
    "dompurify": "3.4.16",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "exceljs": "4.4.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "monaco-editor": "0.55.1",
    "monaco-sql-languages": "^1.2.1",
    "node-sql-parser": "^5.4.0",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.12",
    "pdfjs-dist": "^6.4.299",
    "pinia": "3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.11.0",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.3.3",
    "three": "0.185.1",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@file-viewer/vite-plugin": "3.1.2",
    "@playwright/test": "^1.63.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/three": "0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.43",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "8.1.1",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-demi": "^0.14.10",
    "vue-eslint-parser": "10.4.1",
    "vue-img-cutter": "^3.1.1",
    "vue-tsc": "~3.3.12"
  },
  "description": "基于 Vue 3、TypeScript、Element Plus 与 Supabase 的企业级中后台平台模板：多租户、RBAC 与字段权限、动态菜单、工作流引擎、AI 助手与 SQL 工作台，并以 FMS 财务模块作为业务子应用接入示例。",
  "main": "index.js",
  "keywords": [
    "supabase",
    "vue3",
    "element-plus",
    "admin-template",
    "admin-dashboard",
    "ai-sql",
    "sql-assistant",
    "postgresql",
    "rbac",
    "multi-tenant",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC"
}
